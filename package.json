{
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node seed.js",
    "server": "node server.js",
    "clean": "powershell -Command \"Get-NetTCPConnection -LocalPort 5000,3000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "all": "concurrently -n \"SERVER,FRONTEND\" -c \"green,blue\" \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "autoprefixer": "^10.0.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "mongoose": "^9.3.3",
    "next": "14.2.35",
    "postcss": "^8.4.31",
    "react": "^18",
    "react-dom": "^18",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
